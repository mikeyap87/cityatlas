{
  "name": "cityatlas-launch-ready-product",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "smoke": "npm run qa:smoke:local",
    "typecheck": "tsc -b",
    "readiness": "node scripts/readiness-report.mjs",
    "growth:verify": "node --experimental-strip-types scripts/verify-growth-machine.mjs",
    "growth:packets": "node scripts/build-growth-packets.mjs",
    "growth:sync:all": "node scripts/sync-growth-seeds.mjs",
    "growth:sync:rooms:vancouver": "node scripts/sync-rooms-vancouver-business-seeds.mjs",
    "growth:sync:rooms:vancouver:review": "node scripts/sync-rooms-vancouver-review-business-seeds.mjs",
    "growth:sync:rooms:multi-city": "node scripts/sync-rooms-multi-city-business-seeds.mjs",
    "growth:sync:rooms:connectors": "node scripts/sync-rooms-connector-seeds.mjs",
    "growth:sync:rooms:rehearsal": "node scripts/sync-rooms-outreach-rehearsal-seeds.mjs",
    "growth:sync:roam:business-wave": "node scripts/sync-roam-public-business-wave-seeds.mjs",
    "growth:sync:roam:cities": "node scripts/sync-roam-city-sourcing-seeds.mjs",
    "qa:smoke:local": "node scripts/verify-local-product-smoke.mjs",
    "qa:planner:summary": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-planner-save-summary.mjs",
    "seo:proof": "node --experimental-strip-types scripts/verify-seo-content-machine.mjs",
    "seo:structure:proof": "node --experimental-strip-types scripts/verify-seo-structure.mjs",
    "seo:copy:proof": "node scripts/verify-public-copy-safety.mjs",
    "seo:copy:rendered:proof": "node scripts/verify-rendered-public-copy-safety.mjs",
    "seo:docs:proof": "node --experimental-strip-types scripts/verify-seo-docs.mjs",
    "seo:docs:sync": "node --experimental-strip-types scripts/sync-seo-doc-truth.mjs",
    "seo:indexnow:dry": "node scripts/submit-indexnow.mjs --dry-run",
    "seo:indexnow:submit": "node scripts/submit-indexnow.mjs",
    "seo:smoke:first": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile first-source-backed",
    "seo:smoke:second": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile second-source-backed",
    "seo:smoke:sunday": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile sunday-source-backed",
    "seo:smoke:returning": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile returning-visitor-source-backed",
    "seo:smoke:kitsilano": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile kitsilano-scenic-source-backed",
    "seo:smoke:westside": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile west-side-daytime-source-backed",
    "seo:smoke:falsecreek": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile false-creek-culture-source-backed",
    "seo:smoke:ubc": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile ubc-discovery-source-backed",
    "seo:smoke:garden": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile garden-day-source-backed",
    "seo:smoke:starterpack": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile starter-pack-routing",
    "seo:smoke:roundup": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile guide-roundup-routing",
    "seo:smoke:lowfriction": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile low-friction-routing",
    "seo:smoke:toronto": "node --experimental-strip-types scripts/verify-seo-hosted-smoke.mjs --profile toronto-pilot",
    "seo:proof:stack": "node scripts/verify-seo-proof-stack.mjs",
    "proof:sprint": "node scripts/build-proof-sprint-packet.mjs",
    "replies:analyze": "node scripts/analyze-proof-sprint-replies.mjs",
    "qa:file-preview": "node scripts/build-file-preview.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^8.0.16",
    "typescript": "^5.9.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}
