# CityAtlas launch package environment template.
# Do not put real secrets in this file.

# Public app mode. Keep false until live launch approval.
VITE_CITYATLAS_ENABLE_LIVE_PAYMENTS=false
VITE_CITYATLAS_ENABLE_REAL_PROVIDER_IMPORTS=false
VITE_CITYATLAS_ENABLE_AUTOMATED_OUTREACH=false
VITE_CITYATLAS_ENABLE_HOSTED_ADMIN=false
VITE_CITYATLAS_ENABLE_HOSTED_PRIVATE_PREVIEW=false
VITE_CITYATLAS_PUBLIC_BASE_URL=http://127.0.0.1:5178
# Future hosted base URL after Vercel, Cloudflare DNS, and admin/private-preview
# protection are explicitly approved:
# VITE_CITYATLAS_PUBLIC_BASE_URL=https://city.univenturestudio.com

# Optional future Supabase public client config.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Optional future analytics. Keep blank in local demo mode. Paid traffic should
# not start until a real destination is configured and hosted smoke confirms
# conversion events.
VITE_CITYATLAS_ANALYTICS_PROVIDER=
VITE_GA_MEASUREMENT_ID=
VITE_ANALYTICS_ID=

# Optional future discovery-only and draft-footer prep. These do not unlock
# sending by themselves.
EXA_API_KEY=
CITYATLAS_OUTREACH_MAILING_ADDRESS=

# Optional local-only enrichment provider for research batches. Keep disabled
# unless the owner approves a real paid enrichment run.
OUTSCRAPER_API_KEY=
CITYATLAS_ALLOW_OUTSCRAPER_ENRICHMENT=0

# Optional future payment links. The app intentionally does not use them while
# VITE_CITYATLAS_ENABLE_LIVE_PAYMENTS=false.
VITE_STRIPE_CITY_PARTNER_PAYMENT_LINK=
VITE_STRIPE_SIGNATURE_PARTNER_PAYMENT_LINK=
VITE_STRIPE_CITY_PARTNER_PRICE_ID=
VITE_STRIPE_SIGNATURE_PARTNER_PRICE_ID=
